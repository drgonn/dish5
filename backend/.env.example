# dish5 配置 — 复制为 .env 并修改
APP_NAME=dish5
DEBUG=true

# PostgreSQL 数据库
PG_HOST=localhost
PG_PORT=5434
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=dish5

# 也可直接用 DATABASE_URL (优先)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/dish5

# 定时任务时间 (时区: Asia/Shanghai)
RECOMMEND_HOUR=8
RECOMMEND_MINUTE=0

# 企业微信通知 Webhook (可选)
# NOTIFICATION_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
